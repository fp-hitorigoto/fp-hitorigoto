---
import BaseLayout from '../../layouts/BaseLayout.astro';

const apps = [
  {
    href: 'https://fp3-quiz.vercel.app',
    icon: '📝',
    title: 'FP3級 過去問チャレンジ',
    desc: '全6分野・120問。解説と「試験のポイント」つき。',
    color: 'bg-teal-50 border-teal-200 hover:bg-teal-100 text-teal-800',
  },
  {
    href: 'https://fp2-quiz-app.vercel.app',
    icon: '🎓',
    title: 'FP2級 過去問チャレンジ',
    desc: '全6分野・120問。計算問題も入っています。',
    color: 'bg-blue-50 border-blue-200 hover:bg-blue-100 text-blue-800',
  },
  {
    href: 'https://fp3-tango-app.vercel.app',
    icon: '🃏',
    title: 'FP3級 用語集',
    desc: '145語。カードをめくって覚える形式。「覚えた」で出題から外せます。',
    color: 'bg-green-50 border-green-200 hover:bg-green-100 text-green-800',
  },
  {
    href: 'https://fp2-tango-app.vercel.app',
    icon: '🃏',
    title: 'FP2級 用語集',
    desc: '306語。カードをめくって覚える形式。「覚えた」で出題から外せます。',
    color: 'bg-purple-50 border-purple-200 hover:bg-purple-100 text-purple-800',
  },
];

// 公開済みの再生リストだけを載せる。公開したら追記する。
const songs3 = [
  { vol: 'Vol.1', name: 'ライフプランニング', url: 'https://www.youtube.com/playlist?list=PLMttN7YgkIm2p_A9RhW0YMS4p5Ql7L7yD' },
  { vol: 'Vol.2', name: 'リスク管理', url: 'https://www.youtube.com/playlist?list=PLMttN7YgkIm1JZD9rsGRi6yZh7uLyJoy8' },
  { vol: 'Vol.3', name: '金融資産運用', url: 'https://www.youtube.com/playlist?list=PLMttN7YgkIm1hi_jgmNmt2PYac08atoZB' },
  { vol: 'Vol.4', name: 'タックスプランニング', url: 'https://www.youtube.com/playlist?list=PLQL9EL4nG9q4' },
  { vol: 'Vol.5', name: '不動産', url: 'https://www.youtube.com/playlist?list=PLRrS9d_JKMaE' },
  { vol: 'Vol.6', name: '相続・事業承継', url: 'https://www.youtube.com/playlist?list=PLes7WJbxNpJQ' },
];

const songs2 = [
  { vol: 'Vol.1', name: 'ライフプランニングと資金計画', url: 'https://www.youtube.com/playlist?list=PLcRF7zLO1qao' },
  { vol: 'Vol.2', name: 'リスク管理', url: 'https://www.youtube.com/playlist?list=PLYO7tILmVGoo' },
  { vol: 'Vol.3', name: '金融資産運用', url: 'https://www.youtube.com/playlist?list=PLMeVP2dLfEFA' },
];

const description = 'FP3級・2級の過去問クイズと用語集を無料で公開しています。登録もインストールも不要。学習ソングの再生リストもここからどうぞ。';
---

<BaseLayout title="無料アプリと学習ソング" description={description}>

  <!-- 見出し -->
  <section class="bg-gradient-to-br from-navy-800 to-navy-600 text-white rounded-2xl p-6 sm:p-10 mb-10">
    <div class="max-w-2xl">
      <h1 class="text-2xl sm:text-3xl font-bold mb-3">無料アプリと学習ソング</h1>
      <p class="text-navy-100 leading-relaxed">
        FP3級・2級の勉強に使えるものを、ここにまとめました。<br />
        <span class="font-semibold text-gold-400">登録もインストールも要りません。</span>開いたらすぐ始められます。
      </p>
    </div>
  </section>

  <!-- アプリ -->
  <section class="mb-12">
    <h2 class="text-lg font-bold text-navy-800 mb-1">🎯 クイズと用語集</h2>
    <p class="text-sm text-gray-600 mb-4">
      法令基準日は<strong>2026年4月1日</strong>。2026年6月〜2027年3月の試験に対応しています。
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {apps.map((app) => (
        <a
          href={app.href}
          target="_blank"
          rel="noopener noreferrer"
          class={`border rounded-xl p-4 flex items-start gap-3 transition-colors ${app.color}`}
        >
          <span class="text-2xl shrink-0">{app.icon}</span>
          <div>
            <div class="font-semibold text-sm leading-tight">{app.title}</div>
            <div class="text-xs mt-1 opacity-75 leading-relaxed">{app.desc}</div>
          </div>
        </a>
      ))}
    </div>
    <p class="text-xs text-gray-500 mt-3 leading-relaxed">
      問題の解説からは、その分野の学習ソングへ飛べます。苦手な分野は歌で覚えるのも手です。
    </p>
  </section>

  <!-- 学習ソング -->
  <section class="mb-12">
    <h2 class="text-lg font-bold text-navy-800 mb-1">🎵 歌で覚えるFP</h2>
    <p class="text-sm text-gray-600 mb-4">
      試験範囲を曲にしました。通勤中や家事のあいだの聞き流しに。
    </p>

    <h3 class="text-sm font-bold text-gray-700 mb-2">FP3級（全6巻）</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-6">
      {songs3.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-gray-200 rounded-lg px-4 py-3 bg-white hover:bg-gray-50 transition-colors flex items-center gap-3"
        >
          <span class="text-xs font-bold text-navy-700 shrink-0">{s.vol}</span>
          <span class="text-sm">{s.name}</span>
        </a>
      ))}
    </div>

    <h3 class="text-sm font-bold text-gray-700 mb-2">FP2級（公開中の巻）</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-3">
      {songs2.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-gray-200 rounded-lg px-4 py-3 bg-white hover:bg-gray-50 transition-colors flex items-center gap-3"
        >
          <span class="text-xs font-bold text-navy-700 shrink-0">{s.vol}</span>
          <span class="text-sm">{s.name}</span>
        </a>
      ))}
    </div>
    <p class="text-xs text-gray-500 leading-relaxed">
      タックスプランニング・不動産・相続（Vol.4〜6）は制作中です。
    </p>
  </section>

  <!-- チャンネル -->
  <section class="mb-12">
    <h2 class="text-lg font-bold text-navy-800 mb-4">📺 チャンネル</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <a
        href="https://www.youtube.com/channel/UCJaXEOtd9OTSxhg69PyFiTw"
        target="_blank"
        rel="noopener noreferrer"
        class="border rounded-xl p-4 flex items-start gap-3 transition-colors bg-red-50 border-red-200 hover:bg-red-100 text-red-800"
      >
        <span class="text-2xl shrink-0">▶️</span>
        <div>
          <div class="font-semibold text-sm leading-tight">歌で覚えるFP学習チャンネル</div>
          <div class="text-xs mt-1 opacity-75">YouTubeで公開中。新しい曲はここから。</div>
        </div>
      </a>
      <a
        href="https://note.com/fp_hitorigoto"
        target="_blank"
        rel="noopener noreferrer"
        class="border rounded-xl p-4 flex items-start gap-3 transition-colors bg-emerald-50 border-emerald-200 hover:bg-emerald-100 text-emerald-800"
      >
        <span class="text-2xl shrink-0">📗</span>
        <div>
          <div class="font-semibold text-sm leading-tight">note</div>
          <div class="text-xs mt-1 opacity-75">暮らしとお金の話を書いています。</div>
        </div>
      </a>
    </div>
  </section>

  <!-- ブログへ -->
  <section>
    <a
      href={import.meta.env.BASE_URL}
      class="block border border-navy-100 rounded-xl p-4 bg-navy-50 hover:bg-navy-100 transition-colors text-navy-800"
    >
      <div class="font-semibold text-sm">← ブログの記事を読む</div>
      <div class="text-xs mt-1 opacity-75">税制改正・年金・NISA・不動産などの解説記事</div>
    </a>
  </section>

</BaseLayout>
